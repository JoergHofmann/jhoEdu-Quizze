<?xml version="1.0" encoding="UTF-8"?>

<project name="jho-inventar" default="main">

    <target name="prepare" unless="done">
        <echo message="Jetzt geht's los." />
        <echo message="${user.home}" />
        <copy todir="${user.home}/.local/lib">
            <fileset dir="." includes="*.lua" />
        </copy>
		<delete includeemptydirs="true">
		    <fileset dir = "0_TMP" includes = "**/*"/>
		    <fileset dir = "0_OUT" includes = "**/*"/>
        </delete>
		<mkdir dir="0_OUT/css"/>
        <copy todir="0_OUT/css" overwrite="true">
            <fileset dir="css" includes="*.css" />
        </copy>
		<mkdir dir="0_OUT/scripts"/>
        <copy todir="0_OUT/scripts" overwrite="true">
            <fileset dir="scripts" includes="*.js" />
        </copy>
		<mkdir dir="0_OUT/images"/>
        <copy todir="0_OUT/images" overwrite="true">
            <fileset dir="images" includes="*.*" />
        </copy>
		<copy todir="0_TMP" overwrite="true">
			<fileset dir=".">
				<include name="*.lua" />
				<include name="*.yaml" />
				<include name="*.tex" />
				<include name="*.html" />
				<include name="*.md" />
			</fileset>
		</copy>
    </target>

    <target name="main" depends="prepare"  unless="done">
        <echo message="TARGET 'main'"/>
        <exec executable="ypp" output="0_TMP/index.md">
            <arg line="-l jhomarkup.lua -l html5.lua -l inventar.lua index.md" />
        </exec>
        <exec executable="pandoc" dir="0_TMP/">
            <arg line="-f markdown+raw_html -t html5 --mathjax --css=css/sortable3.css --template jho  index.md -s  -o index.html" />
        </exec>
        <copy file="0_TMP/index.html" tofile="0_OUT/index.html" />
		<property name="done" value="done" />
    </target>
</project>
